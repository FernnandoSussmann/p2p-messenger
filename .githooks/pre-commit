#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

cargo fmt --all --check
cargo clippy --all-targets --all-features -- -D warnings
cargo test --workspace

leaks=$(grep -RnE 'get_secret|set_secret' core/src/identity --include='*.rs' | grep -v '^core/src/identity/keychain.rs:' || true)
if [ -n "$leaks" ]; then
    echo "Secret I/O must stay in core/src/identity/keychain.rs:" >&2
    echo "$leaks" >&2
    exit 1
fi
